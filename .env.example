# Adzuna job-search API — free, legal. Register: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — only used for PT, RO, HU and CZ; never commit this key.
JOOBLE_API_KEY=
JOOBLE_REQUEST_LIMIT=500
JOOBLE_REQUEST_INTERVAL=0.5

# Anthropic — only used for the ambiguous residual the taxonomy can't decide
ANTHROPIC_API_KEY=

# Optional overrides
ADZUNA_COUNTRIES=pl,in,mx,nl,de,ch,es,sg
JOOBLE_COUNTRIES=pt,ro,hu,cz
GBS_MAX_PAGES=5
CLASSIFIER_MODEL=claude-sonnet-5
GBS_RECLASSIFY=0
GBS_MODEL_WORKERS=3
GBS_MODEL_REQUEST_INTERVAL=0.25
GBS_MODEL_TIMEOUT=5
